{
  "name": "lil-agents-win",
  "private": false,
  "version": "0.2.1",
  "description": "Windows port of lil agents: animated desktop buddies with floating CLI chat.",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/bhadraagada/lil-agents-win.git"
  },
  "bugs": {
    "url": "https://github.com/bhadraagada/lil-agents-win/issues"
  },
  "homepage": "https://github.com/bhadraagada/lil-agents-win#readme",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:electron": "wait-on http-get://127.0.0.1:5173 && set \"VITE_DEV_SERVER_URL=http://127.0.0.1:5173\" && electron .",
    "build": "npm run build:electron && tsc -b && vite build",
    "build:electron": "tsup electron/main.ts --format esm --out-dir dist-electron --clean --external electron && tsup electron/preload.ts --format cjs --out-dir dist-electron --external electron",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "bun run build && electron .",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:nsis": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "xyz.lilagents.win",
    "productName": "lil agents",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/icons.ico",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "public/icons.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
